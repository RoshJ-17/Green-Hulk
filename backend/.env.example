# Server Configuration
PORT=3000
NODE_ENV=development

# ML labels file (relative to backend root)
LABELS_PATH=./models/class_indices.json

# Database Configuration — PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=green_hulk
# Or use a single connection string (takes precedence over DB_* vars):
# DATABASE_URL=postgres://postgres:<password>@localhost:5432/green_hulk

# Python TFLite micro-service
TFLITE_SERVICE_URL=http://localhost:5000

# Image Processing
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png

# Logging
LOG_LEVEL=debug

# Quality Thresholds
BLUR_THRESHOLD=100.0
MIN_BRIGHTNESS=50.0
MAX_BRIGHTNESS=200.0

# Confidence Thresholds
CONFIDENCE_THRESHOLD=0.35
HIGH_CONFIDENCE_THRESHOLD=0.70
VERY_HIGH_CONFIDENCE=0.90

# OOD Detection
MAX_PROB_THRESHOLD=0.15
ENTROPY_THRESHOLD=3.5
TOP_K_MARGIN_THRESHOLD=0.08

# CORS (comma-separated allowed origins)
FRONTEND_URL=http://localhost:3000,http://localhost:4200,http://127.0.0.1:3000

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=60d
