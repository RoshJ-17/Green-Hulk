# Server Configuration
PORT=3000
NODE_ENV=development

# Model Configuration (TFLite service handles model loading)
MODEL_PATH=./models/model.tflite
LABELS_PATH=./models/class_indices.json

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=123456789
DB_NAME=green_hulk

# Image Processing
MAX_IMAGE_SIZE_MB=10
ALLOWED_IMAGE_FORMATS=jpg,jpeg,png

# Logging
LOG_LEVEL=debug

# Quality Thresholds
BLUR_THRESHOLD=100.0
MIN_BRIGHTNESS=50.0
MAX_BRIGHTNESS=200.0

# Confidence Thresholds
CONFIDENCE_THRESHOLD=0.35
HIGH_CONFIDENCE_THRESHOLD=0.70
VERY_HIGH_CONFIDENCE=0.90

# OOD Detection
MAX_PROB_THRESHOLD=0.15
ENTROPY_THRESHOLD=3.5
TOP_K_MARGIN_THRESHOLD=0.08

# Authentication
JWT_SECRET=green_hulk_secret_key_2024
JWT_EXPIRES_IN=60d

# Python TFLite micro-service URL
TFLITE_SERVICE_URL=http://localhost:5000

# CORS — comma-separated allowed origins (Flutter web + dev servers)
FRONTEND_URL=http://localhost:3000,http://localhost:4200,http://127.0.0.1:3000

# Fast2SMS (Quick SMS API)
# Get your API key from: https://www.fast2sms.com/dashboard/developer
# Leave as-is during development — OTP is always printed to the backend console.
FAST2SMS_API_KEY=YOUR_FAST2SMS_API_KEY_HERE
OTP_EXPIRY_MINUTES=10